{
  "name": "stardle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "turbo:build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "cf:dev": "wrangler pages dev",
    "cf:deploy": "pnpm build && wrangler pages deploy",
    "sync:actors": "node scripts/sync-actor-credits.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@cloudflare/workers-types": "^4.20241218.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
